# Vercel upload ignore list for the `blade-and-mount` project.
# Build needs: index.html, package.json + lockfile, tsconfig.json,
# vite.config.ts, src/, tests/ (tsconfig includes them), public/.
# shots/ is hundreds of megabytes of QA screenshots and is never bundled.

shots/
docs/
tools/
assets-src/
README.md
.npm-cache/
*.log
.DS_Store
