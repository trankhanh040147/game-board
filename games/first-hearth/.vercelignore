# Vercel upload ignore list for the `first-hearth` project.
# Build needs: index.html, package.json + lockfile, tsconfig.json,
# vite.config.ts, src/, tests/ (tsconfig includes them), public/ and tools/
# (tests/helpers.ts imports ../tools/autoplay, and `tsc --noEmit` type-checks
# the tests, so tools/*.ts must be uploaded — do not ignore tools/).
# Everything below is evidence or docs that never reaches dist/.

shots/
docs/
README.md
*.log
.DS_Store
