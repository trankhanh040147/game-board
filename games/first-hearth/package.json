{
  "name": "first-hearth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "First Hearth - a living-world civilization simulation",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5280",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5281",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node tools/shot.mjs",
    "sim": "node tools/simrun.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/inter": "^5.2.5"
  },
  "devDependencies": {
    "puppeteer-core": "^24.10.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
